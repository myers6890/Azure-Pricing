# Set to true to explore the UI with sample AVD sessions (no Azure account required).
AVD_DEMO_MODE=true

# Optional default subscription when not selecting from the UI list.
# AZURE_SUBSCRIPTION_ID=

# Service principal auth (optional). If omitted, DefaultAzureCredential is used
# (Azure CLI `az login`, Visual Studio, managed identity, etc.).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
