# SignOff — Windows AVD Session Manager
#
# Demo mode (default): explore the UI with sample sessions, no Azure login.
AVD_DEMO_MODE=true
#
# For live AVD on Windows:
#   1. .\scripts\Connect-AzureForSignOff.ps1
#   2. Set AVD_DEMO_MODE=false
#   3. .\scripts\Start-SignOff.ps1
#
# Optional service principal (instead of az login):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
#
# Optional default subscription hint (UI still lists all accessible subs):
# AZURE_SUBSCRIPTION_ID=
